---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';

interface Props {
  title?: string;
}
---

<Layout title="Error 404 | Página no encontrada">
  <main class="error-container">
    <div class="error-content">
      <span class="badge">Error 404</span>
      <h1 class="error-title">
        Búsqueda fuera de <br />
        <span class="highlight">Parámetros Óptimos</span>
      </h1>
      
      <p class="error-description">
        La página que intenta consultar no existe o ha cambiado de ruta. En la consultoría estratégica y la ciencia aplicada, la eficiencia radica en corregir el rumbo con precisión.
      </p>

      <blockquote class="error-quote">
        "El desvío en un proceso no representa un fracaso absoluto, sino un indicador de datos brutos que nos obliga a refinar la trayectoria hacia la solución real."
        <footer>— Dra. Diana Sánchez H.</footer>
      </blockquote>

      <div class="error-actions">
        <a href="/" class="btn-primary">Regresar al Inicio</a>
        <a href="/#servicios" class="btn-secondary">Nuestros Servicios</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* --- ESTILOS SCOPED (CSS Puro) --- */
  .error-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 2rem;
    background-color: #f8fafc;
    text-align: center;
    box-sizing: border-box;
  }

  .error-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .badge {
    display: inline-block;
    padding: 0.25rem 1rem;
    border-radius: 9999px;
    background-color: #e6ffed;
    color: #2F855A;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .error-title {
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    color: #1a202c;
    margin-bottom: 1.5rem;
  }

  .highlight {
    color: #38A169;
  }

  .error-description {
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    color: #4a5568;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .error-quote {
    font-style: italic;
    color: #2F855A;
    border-left: 4px solid #48BB78;
    padding-left: 1.5rem;
    margin: 0 auto 2.5rem auto;
    max-width: 550px;
    font-size: 1.05rem;
    text-align: left;
  }

  .error-quote footer {
    font-style: normal;
    font-weight: 600;
    font-size: 0.875rem;
    margin-top: 0.5rem;
    color: #4a5568;
  }

  .error-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background-color: #38A169;
    color: white;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0.375rem;
    transition: background-color 0.3s ease;
  }

  .btn-primary:hover {
    background-color: #2F855A;
  }

  .btn-secondary {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background-color: transparent;
    color: #38A169;
    font-weight: 600;
    text-decoration: none;
    border: 2px solid #38A169;
    border-radius: 0.375rem;
    transition: all 0.3s ease;
  }

  .btn-secondary:hover {
    background-color: #e6ffed;
  }
</style>