---
// src/pages/servicios/[slug].astro
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  const servicios = [
    {
      slug: 'ingenieria-ambiental',
      title: "Ingeniería Hidrosanitaria, Diseño Conceptual de STAR y Resiliencia Pluvial (SuDS)",
      image: "/servicio-ptar-innovapraxis.webp",
      description: `Aseguramos la viabilidad hidrosanitaria, normativa y financiera de su desarrollo desde la pre-inversión o durante ajustes de obra. Ejecutamos memorias de cálculo de aforos reales bajo metodología científica Bottom-Up, diseño conceptual de Sistemas de Tratamiento de Aguas Residuales (STAR) adaptados a geologías complejas (como el suelo kárstico y costero), segregación estratégica de aguas grises hacia núcleos de biofiltración activa, diseño de Sistemas Urbanos de Drenaje Sostenible (SuDS) y blindaje jurídico-ambiental de Línea Base ("Estado Cero"). 

Nuestro entregable constituye un Expediente Ejecutivo y Guía Maestra con planimetría y despieces constructivos milimétricos para que su constructora edifique con cero incertidumbre y reduzca hasta en un 40% el gasto operativo (OPEX) a largo plazo.

ALCANCES, LIMITACIONES Y ALIANZAS DE EJECUCIÓN: Por principio de imparcialidad fiduciaria, Innova Praxis no ejecuta obra civil en campo, no realiza supervisión presencial de obra ni funge como gestor legal ante dependencias. No obstante, si su organización no es una constructora, contamos con alianzas estratégicas certificadas que pueden ejecutar la obra civil y suministrar los biorreactores, equipos o insumos requeridos bajo las especificaciones exactas de nuestro dictamen.`,
      ctaDetail: "Evaluaremos la etapa actual de su proyecto o licitación para estructurar una propuesta formal de consultoría con entregables, alcances y límites transparentes desde el primer día."
    },
    {
      slug: 'arquitectura-sustentable',
      title: "Diagnóstico, Rescate Operativo y Regularización Normativa de STAR",
      image: "/servicio-arquitectura-sustentable-innovapraxis.webp",
      description: `Diseñado para empresas, industrias, universidades y desarrollos en operación cuyos Sistemas de Tratamiento de Aguas Residuales (STAR), biodigestores o antiguas plantas presentan fallos operativos, saturación o riesgo de multas ante la NOM-001-SEMARNAT-2021. Realizamos auditoría física e ingeniería inversa en sitio (conciliando planos antiguos contra la realidad física en campo) y emitimos el Estudio Diagnóstico y Dictamen de Reingeniería con las adecuaciones exactas para rescatar, modernizar y regularizar su infraestructura, incluyendo la especificación de medidores de flujo (NMX-AA-179-SCFI-2018), puertos de muestreo y guía técnica para la exención del pago de derechos ante CONAGUA (DECLARAGUA y SIRALAB).

El dictamen se entrega como una Guía Maestra de Apoyo Técnico (estructurable en etapas modulares acordes a su presupuesto) con la cual sus propios operadores o su constructora de confianza pueden ejecutar los procedimientos y obras civiles de rescate sin detener su operación.

ALCANCES, LIMITACIONES Y ALIANZAS DE EJECUCIÓN: Innova Praxis entrega la ingeniería diagnóstica y proyectiva; no realizamos el trabajo físico en campo para aplicar las soluciones del dictamen ni supervisamos obra civil. Sin embargo, en caso de que usted no cuente con una constructora para ejecutar los trabajos en obra, ponemos a su disposición nuestra red de alianzas estratégicas para la ejecución civil y el suministro de biotecnología, equipos e insumos acordes a las necesidades de su proyecto.`,
      ctaDetail: "Analizaremos la situación actual de su sistema en operación para definir los alcances del levantamiento en sitio y estructurar su diagnóstico de rescate y regularización."
    }
  ];

  return servicios.map((servicio) => ({
    params: { slug: servicio.slug },
    props: { servicio },
  }));
}

const { servicio } = Astro.props;
---

<Layout title={`${servicio.title} | Innova Praxis`}>
  <Navbar />
  
  <main class="service-page">
    <header class="service-header">
      <div class="container">
        <span class="badge">Consultoría Especializada</span>
        <h1 class="service-title">{servicio.title}</h1>
      </div>
    </header>

    <div class="container">
      <div class="service-hero-image">
        <img 
          src={servicio.image} 
          alt={`Consultoría especializada en ${servicio.title} por Innova Praxis`} 
          width="1200" 
          height="600" 
          loading="eager" 
          fetchpriority="high"
          class="service-img"
        />
      </div>
    </div>

    <section class="service-content container">
      <div class="service-details">
        <h2 class="section-subtitle">Descripción del Servicio</h2>
        <p class="description">{servicio.description}</p>
      </div>

      <aside class="service-action-panel">
        <div class="consulting-card">
          <div class="label-b2b">Consultoría B2B</div>
          <h3>Primer Paso: Diagnóstico</h3>
          <p class="cta-call">Solicite una sesión de evaluación para estructurar su proyecto con el rigor técnico que su organización requiere.</p>
          
          <div class="action-buttons">
            <a href="/#contacto" class="btn-primary">Solicitar Evaluación de Proyecto</a>
          </div>

          <hr class="divider" />
          
          <div class="cta-detail">
            <h4>¿Qué incluye esta sesión?</h4>
            <p>{servicio.ctaDetail}</p>
          </div>
        </div>
      </aside>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
  .service-page { background-color: var(--color-bg-light); min-height: 100vh; padding-bottom: 5rem; }
  .service-header { background-color: #ffffff; padding: 4rem 0; border-bottom: 1px solid #e2e8f0; margin-bottom: 2rem; }
  
  .badge {
    display: inline-block; padding: 0.25rem 1rem; border-radius: 9999px;
    background-color: var(--color-primary-light); color: var(--color-primary-dark);
    font-size: 0.875rem; font-weight: 600; text-transform: uppercase; margin-bottom: 1.5rem;
  }

  .service-title { font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; color: var(--color-text-main); line-height: 1.2; }
  
  /* --- NUEVOS ESTILOS PARA LA IMAGEN PANORÁMICA --- */
  .service-hero-image {
    width: 100%;
    margin-bottom: 3rem; /* Separación entre la imagen y el bloque de texto/tarjeta */
    border-radius: 0.5rem;
    overflow: hidden;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    background-color: #0B1325; /* Fondo de carga corporativo */
  }

  .service-img {
    width: 100%;
    height: auto;
    aspect-ratio: 21/9; /* Proporción ultra panorámica, ideal para cabeceras sin empujar el texto muy abajo */
    object-fit: cover;
    display: block;
  }
  /* ------------------------------------------------ */

  .service-content { display: grid; grid-template-columns: 1fr; gap: 3rem; }

  @media (min-width: 992px) { .service-content { grid-template-columns: 3fr 2fr; } }

  .service-details h2 { font-size: 1.5rem; color: var(--color-primary); margin-bottom: 1rem; font-family: var(--font-primary); }
  .description { font-size: 1.125rem; color: var(--color-text-muted); line-height: 1.8; font-family: var(--font-secondary); }

  .consulting-card {
    background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 0.5rem; padding: 2rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); position: sticky; top: 100px;
  }

  .label-b2b { font-size: 0.75rem; text-transform: uppercase; color: var(--color-text-muted); font-weight: 700; margin-bottom: 0.5rem; }
  .consulting-card h3 { font-size: 1.25rem; color: var(--color-text-main); margin-bottom: 1rem; font-family: var(--font-primary); }
  .cta-call { font-size: 0.95rem; color: var(--color-text-main); font-weight: 500; margin-bottom: 1.5rem; }
  
  .btn-primary {
    display: block; background-color: var(--color-primary); color: white; border: none;
    padding: 1rem; font-size: 1rem; font-weight: 700; border-radius: 0.375rem; text-decoration: none;
    text-align: center; transition: background-color 0.3s ease;
  }
  .btn-primary:hover { background-color: var(--color-primary-dark); }

  .divider { border: 0; height: 1px; background-color: #e2e8f0; margin: 2rem 0; }
  .cta-detail h4 { font-size: 0.9rem; color: var(--color-text-main); margin-bottom: 0.5rem; font-weight: 600; }
  .cta-detail p { font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.6; font-style: italic; }
</style>