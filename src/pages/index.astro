---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import AboutUs from '../components/AboutUs.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Innova Praxis | Consultoría Organizacional">
  <Navbar />
  
  <!-- Contenedor semántico que protege toda la vista de desbordamientos -->
  <main class="main-content">
    <Hero />
    
    <section class="services-teaser" id="servicios">
      <div class="container">
        <h2>Nuestras Soluciones</h2>
        <p>Servicios integrales enfocados en la rentabilidad, la innovación tecnológica y el desarrollo humano corporativo.</p>
        
        <div class="teaser-links">
          <a href="/servicios/aceleracion-startups" class="btn-outline">Aceleración y Diagnóstico</a>
          <a href="/servicios/digitalizacion-ia" class="btn-outline">Digitalización e IA</a>
          <a href="/servicios/ingenieria-ambiental" class="btn-outline">Ingeniería Ambiental</a>
          <a href="/servicios/arquitectura-sustentable" class="btn-outline">Arquitectura Sustentable</a>
          <a href="/servicios/puntoagil-logistica" class="btn-outline">División Logística (PuntoÁgil)</a>
        </div>
      </div>
    </section>

    <AboutUs />
    <Contact />
  </main>

  <Footer />
</Layout>

<style>
  /* --- PROTECCIÓN DEL LAYOUT PRINCIPAL --- */
  .main-content {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    width: 100%;
    /* Previene estrictamente el scroll horizontal en toda la página */
    overflow-x: hidden; 
  }

  /* Usamos :global() para asegurar que el body herede los estilos corporativos a través del Layout */
  :global(body) {
    margin: 0;
    padding: 0;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: #f8fafc;
    color: #1a202c;
    /* Doble candado de seguridad para móviles */
    overflow-x: hidden;
    max-width: 100vw;
  }

  /* --- ESTILOS FLUIDOS DEL TEASER --- */
  .services-teaser {
    /* Padding fluido: amplio en desktop, ajustado en móvil */
    padding: clamp(3rem, 6vw, 5rem) clamp(1rem, 4vw, 2rem);
    background-color: #ffffff;
    text-align: center;
    border-bottom: 1px solid #e2e8f0;
    width: 100%;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
  }

  .services-teaser h2 {
    font-size: clamp(2rem, 5vw, 2.5rem);
    color: #2F855A;
    margin-bottom: 1rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .services-teaser p {
    color: #4a5568;
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.6;
    margin: 0 auto clamp(2rem, 4vw, 2.5rem);
    max-width: 700px;
    padding: 0 0.5rem;
  }

  .teaser-links {
    display: flex;
    flex-wrap: wrap;
    /* Gap fluido y centrado seguro */
    gap: clamp(0.75rem, 2vw, 1rem);
    justify-content: center;
    align-items: center;
  }

  .btn-outline {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background-color: transparent;
    color: #38A169;
    font-weight: 600;
    text-decoration: none;
    border: 2px solid #38A169;
    border-radius: 0.375rem;
    transition: all 0.3s ease;
    text-align: center;
    /* Evita que los botones en móviles sean más anchos que la pantalla */
    max-width: 100%;
  }

  .btn-outline:hover {
    background-color: #e6ffed;
    color: #2F855A;
    border-color: #2F855A;
    transform: translateY(-2px);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  /* Ajuste para que los botones abarquen todo el ancho en teléfonos muy pequeños */
  @media (max-width: 480px) {
    .teaser-links {
      flex-direction: column;
      align-items: stretch;
    }
    .btn-outline {
      width: 100%;
    }
  }
</style>