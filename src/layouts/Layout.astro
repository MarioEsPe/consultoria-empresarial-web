---
// src/layouts/Layout.astro
interface Props {
  title?: string;
}

const { title = "Innova Praxis | Consultoría y Transformación Digital" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

{/* Usamos is:global para asegurar que el reseteo de box-sizing se propague a todos los componentes hijos */}
<style is:global>
  /* Reseteo global: previene que paddings o bordes empujen elementos hacia afuera */
  *, *::before, *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 100vw;
    height: 100%;
    /* Previene estrictamente la aparición de barras de desplazamiento horizontal no deseadas en móvil */
    overflow-x: hidden; 
    /* Tipografía base fluida y limpia para la consultoría */
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: #f8fafc; /* Color de fondo general neutro claro */
    color: #1a202c; /* Color de texto principal */
  }
</style>