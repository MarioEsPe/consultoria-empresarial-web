---
// src/components/Footer.astro
---

<footer class="footer-section">
  <div class="container footer-container">
    
    <div class="footer-brand">
      <h3 class="brand-title">Innova<span>Praxis</span></h3>
      <p class="brand-description">
        Optimizamos la rentabilidad y el bienestar laboral a través de la innovación tecnológica y el rigor científico.
      </p>
    </div>

    <div class="footer-links">
      <h4 class="footer-heading">Navegación</h4>
      <ul class="nav-links">
        <li><a href="/">Inicio</a></li>
        <li><a href="/#servicios">Servicios</a></li>
        <li><a href="/nosotros">Nosotros</a></li>
      </ul>
    </div>

    <div class="footer-contact">
      <h4 class="footer-heading">Contacto</h4>
      <p>📍 Mérida, Yucatán, México</p>
      <p>📧 <a href="mailto:hola@innovapraxis.mx" class="contact-link">hola@innovapraxis.mx</a></p>
      <p>📱 <a href="tel:+525584911053" class="contact-link">+52 (558) 491-1053</a></p> 
    </div>

  </div>
  
  <div class="footer-bottom">
    <p>&copy; {new Date().getFullYear()} Innova Praxis. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  /* --- ESTILOS SCOPED (UI B2B Corporativa) --- */
  .footer-section {
    background-color: #09101e; /* Azul Marino Profundo corporativo */
    color: #f8fafc;
    padding: clamp(3rem, 6vw, 5rem) clamp(1rem, 4vw, 2rem) 1.5rem;
    width: 100%;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
  }

  .footer-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 768px) {
    .footer-container {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .brand-title {
    font-family: var(--font-primary, 'Montserrat', sans-serif);
    font-size: clamp(1.5rem, 3vw, 1.75rem);
    font-weight: 800;
    margin-bottom: 1rem;
    letter-spacing: -0.5px;
    color: #ffffff;
  }

  .brand-title span {
    color: var(--color-primary-mid, #48BB78); /* Verde Praxis */
  }

  .brand-description {
    color: #94a3b8;
    line-height: 1.6;
    max-width: 400px;
    font-size: clamp(0.95rem, 1.5vw, 1rem);
    font-family: var(--font-secondary, 'Inter', sans-serif);
  }

  .footer-heading {
    font-family: var(--font-primary, 'Montserrat', sans-serif);
    font-size: 1.125rem;
    margin-bottom: 1.25rem;
    color: #f8fafc;
    font-weight: 700;
  }

  .nav-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-links li {
    margin-bottom: 0.75rem;
  }

  .nav-links a {
    color: #94a3b8;
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-block;
    padding: 0.25rem 0;
    font-size: 0.95rem;
    font-family: var(--font-secondary, 'Inter', sans-serif);
  }

  .nav-links a:hover {
    color: var(--color-primary, #38A169);
    transform: translateX(3px);
  }

  .footer-contact p {
    color: #94a3b8;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
    font-family: var(--font-secondary, 'Inter', sans-serif);
  }

  .contact-link {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .contact-link:hover {
    color: var(--color-primary, #38A169);
  }

  .footer-bottom {
    max-width: 1100px;
    margin: 0 auto;
    padding-top: 1.5rem;
    border-top: 1px solid #1e293b;
    text-align: center;
    color: #64748b;
    font-size: 0.875rem;
    font-family: var(--font-secondary, 'Inter', sans-serif);
  }
</style>