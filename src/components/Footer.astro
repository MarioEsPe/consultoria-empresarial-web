---
// src/components/Footer.astro
// Pie de página principal
---

<footer class="footer-section">
  <div class="footer-container">
    
    <div class="footer-brand">
      <h3>Innova<span>Praxis</span></h3>
      <p>"Optimizamos la rentabilidad y el bienestar laboral a través de la innovación tecnológica y el rigor científico."</p>
    </div>

    <div class="footer-links">
      <h4>Navegación</h4>
      <ul>
        <li><a href="#inicio">Inicio</a></li>
        <li><a href="#servicios">Servicios</a></li>
        <li><a href="#nosotros">Nosotros</a></li>
      </ul>
    </div>

    <div class="footer-contact">
      <h4>Contacto</h4>
      <p>📍 Mérida, Yucatán, México</p>
      <p>📧 <a href="mailto:hola@innovapraxis.mx" class="contact-link">hola@innovapraxis.mx</a></p>
      <p>📱 <a href="tel:+525584911053" class="contact-link">+52 (558) 491-1053</a></p> 
    </div>

  </div>
  
  <div class="footer-bottom">
    <p>&copy; {new Date().getFullYear()} Innova Praxis. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  /* --- ESTILOS SCOPED --- */
  .footer-section {
    background-color: #0f172a; /* Azul muy oscuro, casi negro, ideal para contraste final */
    color: #f8fafc;
    /* Padding fluido: amplio en desktop, ajustado en móvil */
    padding: clamp(3rem, 6vw, 5rem) clamp(1rem, 4vw, 2rem) 1.5rem;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    width: 100%;
  }

  .footer-container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    /* Gap dinámico para evitar colisiones visuales */
    gap: clamp(2rem, 5vw, 4rem);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  /* Punto de quiebre para Tablets y Desktop: Cambia a 3 columnas asimétricas */
  @media (min-width: 768px) {
    .footer-container {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .footer-brand h3 {
    font-size: clamp(1.5rem, 3vw, 1.75rem);
    font-weight: 800;
    margin-bottom: 1rem;
    letter-spacing: -0.5px;
    color: #ffffff;
  }

  .footer-brand h3 span {
    color: #48BB78; /* Verde Medio de la paleta corporativa */
  }

  .footer-brand p {
    color: #94a3b8;
    line-height: 1.6;
    max-width: 400px;
    font-size: clamp(0.95rem, 1.5vw, 1rem);
  }

  .footer-links h4,
  .footer-contact h4 {
    font-size: 1.125rem;
    margin-bottom: 1.25rem;
    color: #f8fafc;
    font-weight: 700;
  }

  .footer-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-bottom: 0.5rem;
  }

  .footer-links a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.3s ease, transform 0.3s ease;
    /* Área táctil ampliada para móviles */
    display: inline-block;
    padding: 0.25rem 0;
    font-size: 0.95rem;
  }

  .footer-links a:hover {
    color: #48BB78;
    transform: translateX(3px); /* Pequeño feedback visual de interacción */
  }

  .footer-contact p {
    color: #94a3b8;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
  }

  .contact-link {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .contact-link:hover {
    color: #48BB78;
  }

  .footer-bottom {
    max-width: 1100px;
    margin: 0 auto;
    padding-top: 1.5rem;
    border-top: 1px solid #1e293b;
    text-align: center;
    color: #64748b;
    font-size: 0.875rem;
  }
</style>