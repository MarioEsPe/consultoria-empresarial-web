---
// src/components/ServicesGrid.astro
// Catálogo de intervenciones estratégicas B2B

const services = [
  {
    title: "Ingeniería Hidrosanitaria, STAR y SuDS",
    description: "Blindaje técnico en pre-inversión, licitaciones y obra nueva. Diseño conceptual de Sistemas de Tratamiento de Aguas Residuales (STAR), segregación de flujos y drenaje sostenible (SuDS) que evitan sobrecostos constructivos (>25%) y reducen hasta un 40% el OPEX.",
    icon: "🔬",
    link: "/servicios/ingenieria-ambiental"
  },
  {
    title: "Diagnóstico, Rescate y Regularización de STAR",
    description: "Ingeniería inversa y dictámenes para empresas e instituciones con sistemas de tratamiento en operación que presentan fallos o incumplimiento ante la NOM-001-SEMARNAT-2021. Entregamos la Guía Maestra de Reingeniería para su rescate y regularización.",
    icon: "🛡️",
    link: "/servicios/arquitectura-sustentable"
  }
];
---

<section id="servicios" class="services-section" aria-label="Catálogo de intervenciones técnicas">
  <div class="container">
    <header class="section-header">
      <h2 class="section-title">Intervenciones Estratégicas</h2>
      <p class="section-subtitle">
        Soluciones de ingeniería y tecnología orientadas a la optimización del Gasto Operativo (OPEX) y el cumplimiento normativo estricto.
      </p>
    </header>

    <div class="services-grid">
      {services.map(service => (
        <a href={service.link} class="service-card">
          <div class="service-icon" aria-hidden="true">{service.icon}</div>
          <h3 class="service-card-title">{service.title}</h3>
          <p class="service-card-desc">{service.description}</p>
          <div class="service-footer">
            <span class="service-link-text">Ver viabilidad técnica</span>
            <span class="arrow" aria-hidden="true">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* Base de la Sección */
  .services-section {
    padding: 6rem 2rem;
    background-color: var(--bg-secondary, #111B30); /* Un tono sutilmente diferente al Hero */
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Encabezado de Sección */
  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 2.5rem;
    color: #FFFFFF;
    margin-bottom: 1rem;
    font-weight: 700;
  }

  .section-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.7);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Cuadrícula CSS (Grid) optimizada */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  /* Tarjetas Interactivas */
  .service-card {
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 2.5rem 2rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .service-card:hover, .service-card:focus {
    transform: translateY(-5px);
    border-color: var(--brand-color, #4CE679);
    box-shadow: 0 10px 30px rgba(76, 230, 121, 0.1);
    outline: none;
  }

  .service-icon {
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
    display: inline-block;
  }

  .service-card-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.3rem;
    color: #FFFFFF;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .service-card-desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
    margin-bottom: 2rem;
    flex-grow: 1; /* Empuja el footer hacia abajo para que todas las tarjetas midan lo mismo */
  }

  /* Botón interno simulado */
  .service-footer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    color: var(--brand-color, #4CE679);
    font-size: 0.9rem;
    transition: gap 0.3s ease;
  }

  .service-card:hover .service-footer {
    gap: 1rem; /* Efecto de flecha que se mueve a la derecha */
  }

  /* Responsivo para móviles pequeños */
  @media (max-width: 768px) {
    .services-section {
      padding: 4rem 1.5rem;
    }
    .section-title {
      font-size: 2rem;
    }
  }
</style>