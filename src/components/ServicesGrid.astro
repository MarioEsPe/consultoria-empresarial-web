---
// src/components/ServicesGrid.astro
const services = [
  {
    title: "Diagnóstico y Transición Digital",
    description: "Dirección estratégica para la evolución ágil de empresas tradicionales hacia modelos de negocio digitales. Implementamos soluciones que justifican su retorno de inversión y elevan la productividad.",
  },
  {
    title: "Optimización de Recursos y Procesos",
    description: "Automatización inteligente de flujos de trabajo para liberar al personal de tareas mecánicas. El enfoque es reducir el estrés operativo mientras incrementamos la rentabilidad corporativa.",
  },
  {
    title: "Coaching y Liderazgo Sustentable",
    description: "Desarrollo de talento humano mediante el pensamiento crítico y la innovación aplicada. Creamos entornos de trabajo eficientes alineados con la sostenibilidad y el bien común.",
  }
];
---

<section id="servicios" class="services-section" aria-label="Nuestras soluciones estratégicas">
  <div class="container">
    <h2 class="section-title">Nuestras Soluciones</h2>
    <p class="section-lead">Servicios integrales enfocados en la rentabilidad, la innovación y el desarrollo humano.</p>
    
    <div class="services-grid">
      {services.map(service => (
        <article class="service-card">
          <h3 class="service-title">{service.title}</h3>
          <p class="service-description">{service.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    padding: clamp(4rem, 8vw, 6rem) clamp(1rem, 4vw, 2rem);
    background-color: var(--color-bg-light); /* #f8fafc */
    text-align: center;
    width: 100%;
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
  }
  
  .section-title {
    color: var(--color-text-main);
    font-size: clamp(2rem, 5vw, 2.5rem);
    margin-bottom: 1.5rem;
    font-weight: 800;
    line-height: 1.2;
    font-family: var(--font-primary);
  }
  
  .section-lead {
    color: var(--color-text-muted);
    max-width: 700px;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.6;
    font-family: var(--font-secondary);
  }
  
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }
  
  .service-card {
    background: #ffffff;
    padding: clamp(2rem, 4vw, 3rem);
    border-radius: 0.375rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
    border-top: 5px solid var(--color-primary-mid); /* Verde Medio */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }
  
  .service-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
  }
  
  .service-title {
    color: var(--color-text-main);
    font-size: 1.25rem;
    margin-bottom: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    font-family: var(--font-primary);
  }
  
  .service-description {
    color: var(--color-text-muted);
    line-height: 1.7;
    font-size: 1rem;
    margin: 0;
    font-family: var(--font-secondary);
  }
</style>