---
// src/components/Services.astro
const services = [
  {
    title: "Diagnóstico y Transición Digital",
    icon: "🚀",
    description: "Dirección estratégica para la evolución ágil de empresas tradicionales hacia modelos de negocio digitales. Implementamos soluciones que justifican su retorno de inversión y elevan la productividad.",
  },
  {
    title: "Optimización de Recursos y Procesos",
    icon: "⚙️",
    description: "Automatización inteligente de flujos de trabajo para liberar al personal de tareas mecánicas. El enfoque es reducir el estrés operativo mientras incrementamos la rentabilidad corporativa.",
  },
  {
    title: "Coaching y Liderazgo Sustentable",
    icon: "🌱",
    description: "Desarrollo de talento humano mediante el pensamiento crítico y la innovación aplicada. Creamos entornos de trabajo eficientes alineados con la sostenibilidad y el bien común.",
  }
];
---

<section id="servicios" class="services-section">
  <div class="container">
    <h2 class="section-subtitle">Nuestras Soluciones</h2>
    <p class="section-lead">Servicios integrales enfocados en la rentabilidad, la innovación y el desarrollo humano.</p>
    
    <div class="services-grid">
      {services.map(service => (
        <div class="service-card">
          <span class="service-icon">{service.icon}</span>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    /* Padding fluido: 6rem en escritorio, reduce gradualmente hasta 3rem en celular */
    padding: clamp(3rem, 6vw, 6rem) clamp(1rem, 4vw, 2rem);
    background-color: #f1f5f9;
    text-align: center;
    width: 100%;
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
  }
  
  .section-subtitle {
    color: #2F855A;
    /* Tamaño de fuente responsivo */
    font-size: clamp(2rem, 5vw, 2.5rem);
    margin-bottom: 1rem;
    font-weight: 800;
    line-height: 1.2;
  }
  
  .section-lead {
    color: #4a5568;
    max-width: 700px;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.6;
    padding: 0 0.5rem;
  }
  
  .services-grid {
    display: grid;
    /* Corrección crítica: usamos min(100%, 280px) para evitar que rompa pantallas menores a 320px */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }
  
  .service-card {
    background: white;
    /* Padding interior fluido para no ahogar el contenido en móviles */
    padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2rem);
    border-radius: 1rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border-top: 5px solid #48BB78;
    display: flex;
    flex-direction: column;
    align-items: center; /* Centra el contenido internamente de forma segura */
  }
  
  .service-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
  }
  
  .service-icon {
    font-size: 3rem;
    display: block;
    margin-bottom: 1.5rem;
  }
  
  .service-card h3 {
    color: #1a202c;
    font-size: 1.35rem; /* Ligeramente ajustado para mejor legibilidad */
    margin-bottom: 1rem;
    font-weight: 700;
    line-height: 1.3;
  }
  
  .service-card p {
    color: #4a5568;
    line-height: 1.6;
    font-size: 1rem;
    margin: 0;
  }
</style>