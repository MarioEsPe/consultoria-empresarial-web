---
// src/components/Services.astro
const services = [
  {
    title: "Diagnóstico y Transición Digital",
    icon: "🚀",
    description: "Dirección estratégica para la evolución ágil de empresas tradicionales hacia modelos de negocio digitales. Implementamos soluciones que justifican su retorno de inversión y elevan la productividad.",
  },
  {
    title: "Optimización de Recursos y Procesos",
    icon: "⚙️",
    description: "Automatización inteligente de flujos de trabajo para liberar al personal de tareas mecánicas. El enfoque es reducir el estrés operativo mientras incrementamos la rentabilidad corporativa.",
  },
  {
    title: "Coaching y Liderazgo Sustentable",
    icon: "🌱",
    description: "Desarrollo de talento humano mediante el pensamiento crítico y la innovación aplicada. Creamos entornos de trabajo eficientes alineados con la sostenibilidad y el bien común.",
  }
];
---

<section id="servicios" class="services-section">
  <div class="container">
    <h2 class="section-subtitle">Nuestras Soluciones</h2>
    <p class="section-lead">Servicios integrales enfocados en la rentabilidad, la innovación y el desarrollo humano.</p>
    
    <div class="services-grid">
      {services.map(service => (
        <div class="service-card">
          <span class="service-icon">{service.icon}</span>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    padding: 6rem 2rem;
    background-color: #f1f5f9; /* Fondo gris tenue para separar del 'Nosotros' */
    text-align: center;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-subtitle {
    color: #2F855A;
    font-size: 2.5rem;
    margin-bottom: 1rem;
    font-weight: 800;
  }
  .section-lead {
    color: #4a5568;
    max-width: 700px;
    margin: 0 auto 4rem;
    font-size: 1.125rem;
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2.5rem;
  }
  .service-card {
    background: white;
    padding: 3rem 2rem;
    border-radius: 1rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border-top: 5px solid #48BB78;
  }
  .service-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
  }
  .service-icon {
    font-size: 3rem;
    display: block;
    margin-bottom: 1.5rem;
  }
  .service-card h3 {
    color: #1a202c;
    font-size: 1.5rem;
    margin-bottom: 1rem;
    font-weight: 700;
  }
  .service-card p {
    color: #4a5568;
    line-height: 1.6;
    font-size: 1rem;
  }
</style>