---
// src/components/Contact.astro
---

<section id="contacto" class="contact-section">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-info">
        <h2 class="section-title">Iniciemos la Evolución</h2>
        <p class="contact-description">
          Contáctanos para un diagnóstico organizacional o asesoría técnica especializada en la Península de Yucatán.
        </p>
        
        <ul class="expertise-list">
          <li>✓ Optimización de Recursos y Procesos</li>
          <li>✓ Cumplimiento Normativo y Ambiental</li>
          <li>✓ Transformación Digital Realista</li>
        </ul>

        <div class="direct-contact">
          <p><strong>Email:</strong> <a href="mailto:hola@innovapraxis.mx">hola@innovapraxis.mx</a></p>
          <p><strong>Teléfono:</strong> 558 491 1053</p>
          <p><strong>Ubicación:</strong> Mérida, Yucatán, México</p>
        </div>
      </div>

      <div class="form-container">
        <form id="contactForm" class="contact-form">
          <div class="form-group">
            <label for="name">Nombre Completo *</label>
            <input type="text" id="name" name="nombre" required minlength="2" maxlength="150" placeholder="Ej. Juan Pérez" />
          </div>
          
          <div class="form-group">
            <label for="email">Correo Corporativo *</label>
            <input type="email" id="email" name="email" required placeholder="juan@empresa.com" />
          </div>

          <div class="form-group">
            <label for="subject">Asunto de Consultoría</label>
            <select id="subject" name="subject">
              <option value="Diagnóstico Organizacional">Diagnóstico Organizacional</option>
              <option value="Transformación Digital">Transformación Digital</option>
              <option value="Sustentabilidad y Rentabilidad">Sustentabilidad y Rentabilidad</option>
              <option value="Otro servicio">Otro servicio</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Mensaje *</label>
            <textarea id="message" name="mensaje" rows="4" required minlength="10" maxlength="2000" placeholder="Describa brevemente su necesidad..."></textarea>
          </div>

          <button type="submit" id="submitBtn" class="btn-submit">Enviar Solicitud</button>
          <p id="formStatus" class="form-status hidden"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  /* --- ESTILOS SCOPED --- */
  .contact-section { 
    /* Padding fluido para mantener consistencia con el resto de las secciones */
    padding: clamp(4rem, 8vw, 6rem) clamp(1rem, 4vw, 2rem); 
    background-color: #ffffff; 
    width: 100%;
  }

  .container { 
    max-width: 1100px; 
    margin: 0 auto; 
    width: 100%;
  }

  .contact-grid { 
    display: grid; 
    grid-template-columns: 1fr 1fr; 
    /* Espaciado que se adapta al tamaño de la pantalla */
    gap: clamp(2rem, 6vw, 4rem); 
    align-items: start; 
  }
  
  .section-title { 
    color: #1a202c; 
    font-size: clamp(2rem, 5vw, 2.5rem); 
    margin-bottom: 1.5rem; 
    font-weight: 800;
    line-height: 1.2;
  }

  .contact-description { 
    font-size: clamp(1rem, 2vw, 1.125rem); 
    color: #4a5568; 
    margin-bottom: 2rem; 
    line-height: 1.6;
  }
  
  .expertise-list { 
    list-style: none; 
    padding: 0; 
    margin-bottom: 2rem; 
    color: #2F855A; 
    font-weight: 600; 
    font-size: clamp(0.95rem, 1.5vw, 1.05rem);
  }

  .expertise-list li { 
    margin-bottom: 0.75rem; 
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .direct-contact p { 
    margin-bottom: 0.75rem; 
    color: #2d3748; 
    font-size: 1rem;
  }

  .direct-contact a { 
    color: #38A169; 
    text-decoration: none; 
    font-weight: 600; 
    transition: color 0.3s ease;
  }

  .direct-contact a:hover {
    color: #2F855A;
  }

  .form-container { 
    background: #f8fafc; 
    padding: clamp(1.5rem, 4vw, 2.5rem); 
    border-radius: 1rem; 
    box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05), 0 8px 10px -6px rgba(0,0,0,0.01);
    border: 1px solid #e2e8f0;
  }

  .form-group { 
    margin-bottom: 1.5rem; 
    text-align: left; 
    width: 100%;
  }

  .form-group label { 
    display: block; 
    margin-bottom: 0.5rem; 
    font-weight: 600; 
    color: #2d3748; 
    font-size: 0.95rem;
  }

  .form-group input, 
  .form-group select, 
  .form-group textarea {
    width: 100%; 
    padding: 0.875rem; /* Padding más amplio para UX táctil */
    border: 1px solid #cbd5e1; 
    border-radius: 0.375rem; 
    font-family: inherit;
    /* 1rem estricto evita que iOS haga zoom en los inputs */
    font-size: 1rem; 
    color: #1a202c;
    background-color: #ffffff;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  /* Estados visuales corporativos al escribir */
  .form-group input:focus, 
  .form-group select:focus, 
  .form-group textarea:focus {
    outline: none;
    border-color: #38A169;
    box-shadow: 0 0 0 3px rgba(56, 161, 105, 0.2);
  }
  
  .btn-submit {
    width: 100%; 
    padding: 1rem; 
    background-color: #38A169; 
    color: white; 
    border: none;
    border-radius: 0.375rem; 
    font-weight: 700; 
    font-size: 1rem;
    cursor: pointer; 
    transition: background-color 0.3s ease, transform 0.1s ease;
  }

  .btn-submit:hover:not(:disabled) { 
    background-color: #2F855A; 
  }

  .btn-submit:active:not(:disabled) {
    transform: scale(0.98);
  }

  .btn-submit:disabled { 
    background-color: #a0aec0; 
    cursor: not-allowed; 
  }

  .hidden { 
    display: none; 
  }

  .form-status { 
    margin-top: 1rem; 
    font-weight: 600; 
    padding: 0.75rem; 
    border-radius: 0.375rem; 
    text-align: center;
    font-size: 0.95rem;
    background-color: #ffffff;
    border: 1px solid currentColor;
  }
  
  /* Punto de quiebre para Tablets y Celulares */
  @media (max-width: 860px) { 
    .contact-grid { 
      grid-template-columns: 1fr; 
    }
    
    .contact-info {
      text-align: center;
    }

    .expertise-list li {
      justify-content: center;
    }
  }
</style>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const status = document.getElementById('formStatus') as HTMLElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Enviando...";
    }

    const formData = new FormData(form);
    const payload = {
      nombre: formData.get('nombre')?.toString().trim(),
      email: formData.get('email')?.toString().trim(),
      empresa: formData.get('subject')?.toString().trim(),
      mensaje: formData.get('mensaje')?.toString().trim()
    };

    if (!payload.nombre || !payload.email || !payload.mensaje) {
      showStatus("Por favor, complete todos los campos obligatorios.", "#c53030");
      resetButton();
      return;
    }

    try {
      const response = await fetch('https://5o3u9f4x7l.execute-api.us-east-2.amazonaws.com/contacto', {
        method: 'POST',
        body: JSON.stringify(payload),
        headers: { 'Content-Type': 'application/json' }
      });

      // AUDITORÍA: Lectura segura de la respuesta de AWS
      let mensajeRespuesta = "Solicitud enviada. La Dra. Diana Sánchez Herrera le contactará pronto.";
      let errorRespuesta = "Ocurrió un problema en el servidor al validar los datos.";

      try {
        const data = await response.json();
        if (data.mensaje) mensajeRespuesta = data.mensaje;
        if (data.error) errorRespuesta = data.error;
      } catch (jsonErr) {
        // Si el API Gateway no devuelve JSON sino texto plano, lo capturamos aquí sin romper el flujo
        console.log("La respuesta de AWS no es JSON, procesando como texto plano.");
      }

      if (response.ok) {
        // Si AWS responde 200, forzamos tu mensaje corporativo originalizado
        showStatus("Solicitud enviada. La Dra. Diana Sánchez Herrera le contactará pronto.", "#2F855A");
        form.reset();
      } else {
        showStatus(errorRespuesta, "#c53030");
      }
    } catch (err) {
      showStatus("Error al conectar con el servidor de Innova Praxis. Intente de nuevo.", "#c53030");
    } finally {
      resetButton();
    }
  });

  function showStatus(text: string, color: string) {
    if (status) {
      status.textContent = text;
      status.style.color = color;
      status.classList.remove('hidden');
    }
  }

  function resetButton() {
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = "Enviar Solicitud";
    }
  }
</script>