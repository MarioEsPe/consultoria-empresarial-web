---
// src/components/Contact.astro
// Formulario de Cualificación B2B conectado a AWS API Gateway
---

<section id="contacto" class="contact-section" aria-label="Solicitud de evaluación técnica">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-info">
        <h2 class="section-title">Iniciemos el Diagnóstico</h2>
        <p class="lead-text">
          Evaluamos la viabilidad técnica y financiera de su proyecto bajo estricta confidencialidad.
        </p>
        
        <div class="contact-details">
          <div class="detail-item">
            <span class="icon" aria-hidden="true">📍</span>
            <div>
              <strong>Base de Operaciones</strong>
              <p>Mérida, Yucatán, México. <br/> (Despliegue regional y nacional)</p>
            </div>
          </div>
          
          <div class="detail-item">
            <span class="icon" aria-hidden="true">📞</span>
            <div>
              <strong>Línea de Enlace Directivo</strong>
              <p><a href="tel:5584911053">55 8491 1053</a></p>
            </div>
          </div>

          <div class="detail-item">
            <span class="icon" aria-hidden="true">✉️</span>
            <div>
              <strong>Dirección Ejecutiva</strong>
              <p><a href="mailto:directiva@innovapraxis.mx">directiva@innovapraxis.mx</a></p>
            </div>
          </div>
        </div>
      </div>

      <div class="contact-form-container">
        <form id="b2b-contact-form" class="b2b-form">
          <div class="form-row">
            <div class="form-group">
              <label for="name">Nombre Completo *</label>
              <input type="text" id="name" name="name" required placeholder="Ej. Ing. Roberto Sánchez" />
            </div>
            <div class="form-group">
              <label for="email">Correo Corporativo *</label>
              <input type="email" id="email" name="email" required placeholder="roberto@suempresa.com" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="company">Empresa / Institución *</label>
              <input type="text" id="company" name="company" required placeholder="Nombre legal o comercial" />
            </div>
            <div class="form-group">
              <label for="position">Cargo / Puesto *</label>
              <input type="text" id="position" name="position" required placeholder="Ej. Dirección de Operaciones" />
            </div>
          </div>

          <div class="form-group">
            <label for="subject">Línea de Interés Técnico *</label>
            <select id="subject" name="subject" required>
              <option value="" disabled selected>Seleccione el área de intervención...</option>
              <option value="Ingeniería Ambiental y PTAR">Ingeniería Ambiental y PTAR</option>
              <option value="Digitalización e IA">Digitalización e IA</option>
              <option value="Project Management">Project Management Hidrosanitario</option>
              <option value="Arquitectura Sustentable">Arquitectura Sustentable</option>
              <option value="Punto Ágil">Punto Ágil (Logística Automatizada)</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Contexto del Proyecto *</label>
            <textarea id="message" name="message" rows="4" required placeholder="Describa brevemente el problema operativo, normativo o de infraestructura a resolver..."></textarea>
          </div>

          <div id="form-status" aria-live="polite"></div>

          <button type="submit" class="btn-submit">Solicitar Evaluación de Proyecto</button>
          <p class="privacy-note">SLA de respuesta garantizado: 24 horas hábiles.</p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 6rem 2rem;
    background-color: var(--bg-primary, #0B1325);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 4rem;
    align-items: flex-start;
  }

  .section-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 2.5rem;
    color: #FFFFFF;
    margin-bottom: 1rem;
    font-weight: 700;
  }

  .lead-text {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
    margin-bottom: 3rem;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .detail-item {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .detail-item .icon {
    font-size: 1.5rem;
    background: rgba(76, 230, 121, 0.1);
    padding: 0.8rem;
    border-radius: 8px;
    color: var(--brand-color, #4CE679);
  }

  .detail-item strong {
    display: block;
    font-family: 'Inter', sans-serif;
    color: #FFFFFF;
    font-size: 1.05rem;
    margin-bottom: 0.3rem;
  }

  .detail-item p, .detail-item a {
    font-family: 'Inter', sans-serif;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
    text-decoration: none;
    line-height: 1.5;
  }

  .detail-item a:hover {
    color: var(--brand-color, #4CE679);
  }

  /* Estilos del Formulario B2B */
  .contact-form-container {
    background: #111B30;
    padding: 3rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-group label {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 0.5rem;
    font-weight: 500;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 0.8rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    color: #FFFFFF;
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    transition: border-color 0.3s ease, background 0.3s ease;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--brand-color, #4CE679);
    background: rgba(255, 255, 255, 0.05);
  }

  .form-group select option {
    background: #111B30;
    color: #FFFFFF;
  }

  .btn-submit {
    width: 100%;
    padding: 1rem;
    background-color: var(--brand-color, #4CE679);
    color: #000000;
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.1s ease;
    margin-top: 1rem;
  }

  .btn-submit:hover:not(:disabled) {
    background-color: #3db861;
  }

  .btn-submit:disabled {
    background-color: #555555;
    cursor: not-allowed;
    color: rgba(255,255,255,0.5);
  }

  .privacy-note {
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.4);
    margin-top: 1rem;
  }

  /* Estilos para mensajes de JS */
  #form-status { margin-bottom: 1rem; }
  .success-msg { color: var(--brand-color, #4CE679); font-size: 0.9rem; font-family: 'Inter', sans-serif; }
  .error-msg { color: #ff6b6b; font-size: 0.9rem; font-family: 'Inter', sans-serif; }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; gap: 3rem; }
    .form-row { grid-template-columns: 1fr; gap: 0; }
    .contact-form-container { padding: 2rem 1.5rem; }
  }
</style>

<script>
  // Lógica de validación B2B y conexión a AWS API Gateway
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('b2b-contact-form') as HTMLFormElement;
    const statusDiv = document.getElementById('form-status');
    const submitBtn = form?.querySelector('.btn-submit') as HTMLButtonElement;

    if (form && statusDiv && submitBtn) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // 1. Filtro B2B: Advertencia para correos gratuitos
        const emailInput = (document.getElementById('email') as HTMLInputElement).value.toLowerCase();
        const freeEmailDomains = ['gmail.com', 'hotmail.com', 'yahoo.com', 'outlook.com', 'live.com'];
        const userDomain = emailInput.split('@')[1];

        if (freeEmailDomains.includes(userDomain)) {
          const proceed = confirm("Para agilizar el análisis de su proyecto sugerimos el uso de un correo corporativo.\n\n¿Desea continuar utilizando este correo personal?");
          if (!proceed) return; // Detiene el envío si el usuario decide cambiar el correo
        }

        // 2. Preparar el Payload para AWS
        const formData = {
          nombre: (document.getElementById('name') as HTMLInputElement).value,
          empresa: (document.getElementById('company') as HTMLInputElement).value,
          cargo: (document.getElementById('position') as HTMLInputElement).value,
          email: emailInput,
          asunto: (document.getElementById('subject') as HTMLSelectElement).value,
          mensaje: (document.getElementById('message') as HTMLTextAreaElement).value
        };

        // 3. UI de Estado de Carga
        submitBtn.disabled = true;
        submitBtn.textContent = "Procesando...";
        statusDiv.innerHTML = "";

        try {
          // 4. Petición al API Gateway (REEMPLAZA ESTA URL POR LA TUYA)
          const AWS_API_URL = 'https://5o3u9f4x7l.execute-api.us-east-2.amazonaws.com/contacto'; 
          
          const response = await fetch(AWS_API_URL, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(formData)
          });

          if (response.ok) {
            statusDiv.innerHTML = '<p class="success-msg">✓ Solicitud cifrada y enviada con éxito. Nuestro equipo le contactará en breve.</p>';
            form.reset();
          } else {
            throw new Error('Error en la validación del servidor');
          }
        } catch (error) {
          statusDiv.innerHTML = '<p class="error-msg">⚠️ Imposible conectar con el servidor. Por favor, intente más tarde o utilice la línea de enlace directo.</p>';
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = "Solicitar Evaluación de Proyecto";
        }
      });
    }
  });
</script>