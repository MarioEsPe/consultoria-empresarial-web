---
// src/components/Contact.astro
---

<section id="contacto" class="contact-section" aria-label="Sección de contacto corporativo">
  <div class="container">
    <div class="contact-grid">
      
      <!-- Panel de Información B2B -->
      <div class="contact-info">
        <h2 class="section-title">Iniciemos la Evolución</h2>
        <p class="contact-description">
          Contáctanos para un diagnóstico organizacional o asesoría técnica especializada en la Península de Yucatán.
        </p>
        
        <ul class="expertise-list">
          <li>✓ Optimización de Recursos y Procesos</li>
          <li>✓ Cumplimiento Normativo y Ambiental</li>
          <li>✓ Transformación Digital Realista</li>
        </ul>

        <div class="direct-contact">
          <p><strong>Email:</strong> <a href="mailto:hola@innovapraxis.mx">hola@innovapraxis.mx</a></p>
          <p><strong>Teléfono:</strong> 558 491 1053</p>
          <p><strong>Ubicación:</strong> Mérida, Yucatán, México</p>
        </div>
      </div>

      <!-- Formulario de Calificación B2B (Candado Anti-Gratis) -->
      <div class="form-container">
        <form id="contactForm" class="contact-form" novalidate>
          
          <div class="form-group">
            <label for="name">Nombre Completo *</label>
            <input type="text" id="name" name="nombre" required minlength="2" maxlength="150" placeholder="Ej. Ing. Roberto Mendoza" />
          </div>

          <!-- Campos B2B Obligatorios -->
          <div class="form-group">
            <label for="empresa">Empresa / Institución / Organización *</label>
            <input type="text" id="empresa" name="empresa" required placeholder="Ej. Constructora Peninsular SA de CV" />
          </div>

          <div class="form-group">
            <label for="cargo">Cargo / Puesto *</label>
            <input type="text" id="cargo" name="cargo" required placeholder="Ej. Director de Operaciones" />
          </div>
          
          <div class="form-group">
            <label for="email">Correo Corporativo * <span class="label-hint">(Veto de Gmail/Hotmail)</span></label>
            <input type="email" id="email" name="email" required placeholder="roberto@empresa.com" />
          </div>

          <div class="form-group">
            <label for="subject">Alcance Estimado / Tipo de Proyecto *</label>
            <select id="subject" name="subject" required>
              <option value="" disabled selected>Seleccione un área de consultoría...</option>
              <option value="Ingeniería PTAR">Ingeniería Ambiental (PTAR)</option>
              <option value="Auditoría Digital">Auditoría y Transformación Digital</option>
              <option value="Desarrollo Organizacional">Diagnóstico y Desarrollo Organizacional</option>
              <option value="Proyecto Vending Punto Ágil">Proyecto Retail / Punto Ágil</option>
              <option value="Otro servicio corporativo">Otro servicio corporativo</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Detalles de la Solicitud *</label>
            <textarea id="message" name="mensaje" rows="4" required minlength="10" maxlength="2000" placeholder="Describa brevemente el contexto de su empresa y la problemática a resolver..."></textarea>
          </div>

          <!-- Micro-Copy Asertivo y de Autoridad -->
          <button type="submit" id="submitBtn" class="btn-submit">Solicitar Evaluación de Proyecto</button>
          
          <!-- Contenedor de estado de envío (Manejo de Error/Éxito) -->
          <div id="formStatus" class="form-status hidden" role="alert"></div>
        </form>
      </div>
      
    </div>
  </div>
</section>

<style>
  /* --- ESTILOS SCOPED --- */
  .contact-section { 
    padding: clamp(4rem, 8vw, 6rem) clamp(1rem, 4vw, 2rem); 
    background-color: #ffffff; 
    width: 100%;
  }

  .container { 
    max-width: 1100px; 
    margin: 0 auto; 
    width: 100%;
  }

  .contact-grid { 
    display: grid; 
    grid-template-columns: 1fr 1fr; 
    gap: clamp(2rem, 6vw, 4rem); 
    align-items: start; 
  }
  
  .section-title { 
    color: #1a202c; 
    font-size: clamp(2rem, 5vw, 2.5rem); 
    margin-bottom: 1.5rem; 
    font-weight: 800;
    line-height: 1.2;
    font-family: var(--font-primary, 'Montserrat', sans-serif);
  }

  .contact-description { 
    font-size: clamp(1rem, 2vw, 1.125rem); 
    color: #4a5568; 
    margin-bottom: 2rem; 
    line-height: 1.6;
  }
  
  .expertise-list { 
    list-style: none; 
    padding: 0; 
    margin-bottom: 2rem; 
    color: #2F855A; 
    font-weight: 600; 
    font-size: clamp(0.95rem, 1.5vw, 1.05rem);
  }

  .expertise-list li { 
    margin-bottom: 0.75rem; 
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .direct-contact p { 
    margin-bottom: 0.75rem; 
    color: #2d3748; 
    font-size: 1rem;
  }

  .direct-contact a { 
    color: #38A169; 
    text-decoration: none; 
    font-weight: 600; 
    transition: color 0.3s ease;
  }

  .direct-contact a:hover {
    color: #2F855A;
  }

  .form-container { 
    background: #f8fafc; 
    padding: clamp(1.5rem, 4vw, 2.5rem); 
    border-radius: 1rem; 
    box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05), 0 8px 10px -6px rgba(0,0,0,0.01);
    border: 1px solid #e2e8f0;
  }

  .form-group { 
    margin-bottom: 1.5rem; 
    text-align: left; 
    width: 100%;
  }

  .form-group label { 
    display: block; 
    margin-bottom: 0.5rem; 
    font-weight: 600; 
    color: #2d3748; 
    font-size: 0.95rem;
  }

  .label-hint {
    font-weight: 400;
    color: #EF4444; /* Rojo técnico para advertencia B2B */
    font-size: 0.8rem;
    margin-left: 0.25rem;
  }

  .form-group input, 
  .form-group select, 
  .form-group textarea {
    width: 100%; 
    padding: 0.875rem; 
    border: 1px solid #cbd5e1; 
    border-radius: 0.375rem; 
    font-family: inherit;
    font-size: 1rem; 
    color: #1a202c;
    background-color: #ffffff;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .form-group input:focus, 
  .form-group select:focus, 
  .form-group textarea:focus {
    outline: none;
    border-color: #38A169;
    box-shadow: 0 0 0 3px rgba(56, 161, 105, 0.2);
  }
  
  /* Botón con estilo UI B2B Cognitivo */
  .btn-submit {
    width: 100%; 
    padding: 1rem; 
    background-color: #38A169; 
    color: white; 
    border: none;
    border-radius: 0.375rem; 
    font-family: var(--font-primary, 'Montserrat', sans-serif);
    font-weight: 700; 
    font-size: 1rem;
    cursor: pointer; 
    transition: background-color 0.3s ease, transform 0.1s ease;
  }

  .btn-submit:hover:not(:disabled) { 
    background-color: #2F855A; 
  }

  .btn-submit:active:not(:disabled) {
    transform: scale(0.98);
  }

  .btn-submit:disabled { 
    background-color: #a0aec0; 
    cursor: not-allowed; 
  }

  .hidden { 
    display: none; 
  }

  .form-status { 
    margin-top: 1rem; 
    font-weight: 600; 
    padding: 0.75rem; 
    border-radius: 0.375rem; 
    text-align: center;
    font-size: 0.95rem;
    background-color: #ffffff;
    border: 1px solid currentColor;
    font-family: var(--font-secondary, 'Inter', sans-serif);
  }
  
  @media (max-width: 860px) { 
    .contact-grid { 
      grid-template-columns: 1fr; 
    }
    
    .contact-info {
      text-align: center;
    }

    .expertise-list li {
      justify-content: center;
    }
  }
</style>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const status = document.getElementById('formStatus') as HTMLElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Procesando...";
    }

    const formData = new FormData(form);
    const emailStr = formData.get('email')?.toString().trim().toLowerCase() || "";
    
    // Regla Estricta: Veto de dominios genéricos para filtrar B2B
    const dominiosProhibidos = ['@gmail.com', '@hotmail.com', '@yahoo.com', '@outlook.com'];
    const esCorreoGratuito = dominiosProhibidos.some(dominio => emailStr.includes(dominio));

    if (esCorreoGratuito) {
      showStatus("Por favor, utilice un correo corporativo. Se restringen cuentas gratuitas.", "#EF4444");
      resetButton();
      return;
    }

    const payload = {
      nombre: formData.get('nombre')?.toString().trim(),
      empresa: formData.get('empresa')?.toString().trim(),
      cargo: formData.get('cargo')?.toString().trim(),
      email: emailStr,
      asunto: formData.get('subject')?.toString().trim(),
      mensaje: formData.get('mensaje')?.toString().trim()
    };

    if (!payload.nombre || !payload.email || !payload.mensaje || !payload.empresa || !payload.asunto) {
      showStatus("Por favor, complete todos los campos obligatorios.", "#EF4444");
      resetButton();
      return;
    }

    try {
      // Reemplazar con el endpoint final de API Gateway
      const response = await fetch('https://5o3u9f4x7l.execute-api.us-east-2.amazonaws.com/contacto', {
        method: 'POST',
        body: JSON.stringify(payload),
        headers: { 'Content-Type': 'application/json' }
      });

      let mensajeRespuesta = "Evaluación solicitada. El equipo de Innova Praxis le contactará a la brevedad.";
      let errorRespuesta = "Ocurrió un problema de conectividad al procesar la solicitud.";

      try {
        const data = await response.json();
        if (data.mensaje) mensajeRespuesta = data.mensaje;
        if (data.error) errorRespuesta = data.error;
      } catch (jsonErr) {
        console.log("Respuesta de AWS parseada como texto plano.");
      }

      if (response.ok) {
        showStatus("Solicitud corporativa recibida exitosamente.", "#2F855A");
        form.reset();
      } else {
        showStatus(errorRespuesta, "#EF4444");
      }
    } catch (err) {
      showStatus("Error al conectar con la infraestructura. Intente de nuevo más tarde.", "#EF4444");
    } finally {
      resetButton();
    }
  });

  function showStatus(text: string, color: string) {
    if (status) {
      status.textContent = text;
      status.style.color = color;
      status.classList.remove('hidden');
    }
  }

  function resetButton() {
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = "Solicitar Evaluación de Proyecto";
    }
  }
</script>