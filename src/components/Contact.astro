---
// src/components/Contact.astro
---

<section id="contacto" class="contact-section">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-info">
        <h2 class="section-title">Iniciemos la Evolución</h2>
        <p class="contact-description">
          Contáctanos para un diagnóstico organizacional o asesoría técnica especializada en la Península de Yucatán.
        </p>
        
        <ul class="expertise-list">
          <li>✓ Optimización de Recursos y Procesos</li>
          <li>✓ Cumplimiento Normativo y Ambiental</li>
          <li>✓ Transformación Digital Realista</li>
        </ul>

        <div class="direct-contact">
          <p><strong>Email:</strong> <a href="mailto:hola@innovapraxis.mx">hola@innovapraxis.mx</a></p>
          <p><strong>Teléfono:</strong> 999 700 0372</p>
          <p><strong>Ubicación:</strong> Mérida, Yucatán, México</p>
        </div>
      </div>

      <div class="form-container">
        <form id="contactForm" class="contact-form">
          <div class="form-group">
            <label for="name">Nombre Completo *</label>
            <input type="text" id="name" name="nombre" required minlength="2" maxlength="150" placeholder="Ej. Juan Pérez" />
          </div>
          
          <div class="form-group">
            <label for="email">Correo Corporativo *</label>
            <input type="email" id="email" name="email" required placeholder="juan@empresa.com" />
          </div>

          <div class="form-group">
            <label for="subject">Asunto de Consultoría</label>
            <select id="subject" name="subject">
              <option value="Diagnóstico Organizacional">Diagnóstico Organizacional</option>
              <option value="Transformación Digital">Transformación Digital</option>
              <option value="Sustentabilidad y Rentabilidad">Sustentabilidad y Rentabilidad</option>
              <option value="Otro servicio">Otro servicio</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Mensaje *</label>
            <textarea id="message" name="mensaje" rows="4" required minlength="10" maxlength="2000" placeholder="Describa brevemente su necesidad..."></textarea>
          </div>

          <button type="submit" id="submitBtn" class="btn-submit">Enviar Solicitud</button>
          <p id="formStatus" class="form-status hidden"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section { padding: 6rem 2rem; background-color: #ffffff; }
  .container { max-width: 1100px; margin: 0 auto; }
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
  
  .section-title { color: #1a202c; font-size: 2.5rem; margin-bottom: 1.5rem; }
  .contact-description { font-size: 1.1rem; color: #4a5568; margin-bottom: 2rem; }
  
  .expertise-list { list-style: none; padding: 0; margin-bottom: 2rem; color: #2F855A; font-weight: 600; }
  .expertise-list li { margin-bottom: 0.5rem; }

  .direct-contact p { margin-bottom: 0.75rem; color: #2d3748; }
  .direct-contact a { color: #38A169; text-decoration: none; font-weight: 600; }

  .form-container { background: #f8fafc; padding: 2.5rem; border-radius: 1rem; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); }
  .form-group { margin-bottom: 1.5rem; text-align: left; }
  .form-group label { display: block; margin-bottom: 0.5rem; font-weight: 600; color: #2d3748; }
  .form-group input, .form-group select, .form-group textarea {
    width: 100%; padding: 0.75rem; border: 1px solid #e2e8f0; border-radius: 0.375rem; font-family: inherit;
  }
  
  .btn-submit {
    width: 100%; padding: 1rem; background-color: #2F855A; color: white; border: none;
    border-radius: 0.375rem; font-weight: 700; cursor: pointer; transition: background 0.3s;
  }
  .btn-submit:hover { background-color: #276749; }
  .btn-submit:disabled { background-color: #a0aec0; cursor: not-allowed; }
  .hidden { display: none; }
  .form-status { margin-top: 1rem; font-weight: 600; padding: 0.5rem; border-radius: 0.25rem; }
  
  @media (max-width: 768px) { .contact-grid { grid-template-columns: 1fr; } }
</style>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const status = document.getElementById('formStatus') as HTMLElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    // Deshabilitar botón para evitar doble envío accidental (Double Submit)
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Enviando...";
    }

    const formData = new FormData(form);
    
    // Construimos el objeto JSON adaptado exactamente a lo que espera la Lambda
    const payload = {
      nombre: formData.get('nombre')?.toString().trim(),
      email: formData.get('email')?.toString().trim(),
      // Mapeamos el "asunto" al campo "empresa" para reutilizar tu estructura de correo actual sin costos extra
      empresa: formData.get('subject')?.toString().trim(),
      mensaje: formData.get('mensaje')?.toString().trim()
    };

    // Validación previa rápida en el cliente
    if (!payload.nombre || !payload.email || !payload.mensaje) {
      showStatus("Por favor, complete todos los campos obligatorios.", "#c53030");
      resetButton();
      return;
    }

    try {
      // Tu URL real de AWS API Gateway provista en tu código base
      const response = await fetch('https://5o3u9f4x7l.execute-api.us-east-2.amazonaws.com/contacto', {
        method: 'POST',
        body: JSON.stringify(payload),
        headers: { 'Content-Type': 'application/json' }
      });

      // Intentamos leer la respuesta JSON devuelta por la Lambda
      const data = await response.json();

      if (response.ok) {
        // Respuesta HTTP 200 de la Lambda exitosa
        showStatus(data.mensaje || "Solicitud enviada. La Dra. Diana Sánchez Herrera le contactará pronto.", "#2F855A");
        form.reset();
      } else {
        // Respuestas HTTP 400, 422 o 500 controladas por nuestro Backend
        showStatus(data.error || "Ocurrió un problema en el servidor al validar los datos.", "#c53030");
      }
    } catch (err) {
      // Fallo crítico de red (sin conexión a internet, caída de DNS de AWS, etc.)
      showStatus("Error al conectar con el servidor de Innova Praxis. Intente de nuevo.", "#c53030");
    } finally {
      resetButton();
    }
  });

  function showStatus(text: string, color: string) {
    if (status) {
      status.textContent = text;
      status.style.color = color;
      status.classList.remove('hidden');
    }
  }

  function resetButton() {
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = "Enviar Solicitud";
    }
  }
</script>