// src/components/Navbar.astro
---

<header class="navbar-container">
  <div class="navbar-content">
    <a href="/" class="logo">
      <strong>Innova</strong>Praxis
    </a>
    
    <div class="nav-right-group">
      <nav class="main-nav">
        <ul class="nav-links">
          <li><a href="/">Inicio</a></li>
          
          <li class="dropdown">
            <a href="#" class="dropdown-trigger" aria-haspopup="true">
              Servicios <span class="arrow">&#9662;</span>
            </a>
            <ul class="dropdown-menu">
              <li><a href="/servicios/aceleracion-startups">Aceleración de Startups</a></li>
              <li><a href="/servicios/digitalizacion-ia">Digitalización e IA</a></li>
              <li><a href="/servicios/ingenieria-ambiental">Ingeniería Ambiental</a></li>
              <li><a href="/servicios/arquitectura-sustentable">Arquitectura Sustentable</a></li>
              <li><a href="/servicios/puntoagil-logistica">PuntoÁgil (Logística)</a></li>
            </ul>
          </li>

          <li><a href="/#nosotros">Nosotros</a></li>
        </ul>
      </nav>
      
      <div class="nav-actions">
        <a href="/#contacto" class="btn-primary">Contacto</a>
      </div>
    </div>
    
  </div>
</header>

<style>
  .navbar-container {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
  }

  .navbar-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-size: 1.5rem;
    color: #1a202c;
    text-decoration: none;
    font-weight: 400;
  }

  .logo strong {
    color: #2F855A;
    font-weight: 800;
  }

  /* --- CORRECCIÓN CLAVE AQUÍ --- */
  .nav-right-group {
    display: flex;
    flex-direction: row; /* Fuerza alineación horizontal */
    flex-wrap: nowrap;   /* Evita que el botón baje a otra línea */
    align-items: center;
    gap: 2rem; /* Espacio entre el menú y el botón */
  }

  .main-nav .nav-links {
    display: flex;
    flex-direction: row;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .nav-links a {
    color: #4a5568;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .nav-links a:hover, .nav-links a:focus {
    color: #38A169;
  }

  /* --- Lógica del Dropdown en CSS --- */
  .dropdown {
    position: relative;
    padding-bottom: 0.5rem;
    margin-bottom: -0.5rem;
  }

  .dropdown-trigger {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .arrow {
    font-size: 0.8rem;
    transition: transform 0.3s ease;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    background-color: #ffffff;
    min-width: 280px;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    border-radius: 0.375rem;
    border: 1px solid #e2e8f0;
    list-style: none;
    padding: 0.5rem 0;
    margin: 0;
    
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.3s ease;
  }

  .dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown:hover .arrow {
    transform: rotate(180deg);
  }

  .dropdown-menu li a {
    display: block;
    padding: 0.75rem 1.5rem;
    font-weight: 500;
    color: #4a5568;
    border-left: 3px solid transparent;
  }

  .dropdown-menu li a:hover {
    background-color: #e6ffed;
    color: #2F855A;
    border-left: 3px solid #38A169;
  }

  .nav-actions {
    display: flex;
    align-items: center;
  }

  .btn-primary {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    background-color: #38A169;
    color: white;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0.375rem;
    white-space: nowrap; /* Evita que el texto del botón se rompa */
    transition: background-color 0.3s ease;
  }

  .btn-primary:hover {
    background-color: #2F855A;
  }
</style>