---
// src/components/Navbar.astro
---

<header class="navbar-container">
  <div class="navbar-content">
    <a href="/" class="logo">
      <strong>Innova</strong>Praxis
    </a>
    
    <button id="mobile-menu-btn" class="mobile-toggle" aria-label="Alternar menú">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1a202c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
    
    <div id="nav-right-group" class="nav-right-group">
      <nav class="main-nav">
        <ul class="nav-links">
          <li><a href="/">Inicio</a></li>
          
          <li class="dropdown">
            <a href="javascript:void(0)" class="dropdown-trigger" aria-haspopup="true">
              Servicios <span class="arrow">&#9662;</span>
            </a>
            <ul class="dropdown-menu">
              <li><a href="/servicios/aceleracion-startups">Aceleración de Startups</a></li>
              <li><a href="/servicios/digitalizacion-ia">Digitalización e IA</a></li>
              <li><a href="/servicios/ingenieria-ambiental">Ingeniería Ambiental</a></li>
              <li><a href="/servicios/arquitectura-sustentable">Arquitectura Sustentable</a></li>
              <li><a href="/servicios/puntoagil-logistica">PuntoÁgil (Logística)</a></li>
            </ul>
          </li>

          <li><a href="/#nosotros">Nosotros</a></li>
        </ul>
      </nav>
      
      <div class="nav-actions">
        <a href="/#contacto" class="btn-primary">Contacto</a>
      </div>
    </div>
    
  </div>
</header>

<style>
  /* --- ESTILOS BASE Y DESKTOP --- */
  .navbar-container {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
  }

  .navbar-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem clamp(1rem, 4vw, 2rem);
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
  }

  .logo {
    font-size: 1.5rem;
    color: #1a202c;
    text-decoration: none;
    font-weight: 400;
    z-index: 101; /* Asegura que el logo esté sobre el menú móvil */
  }

  .logo strong {
    color: #2F855A;
    font-weight: 800;
  }

  /* Ocultar botón hamburguesa en Desktop */
  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 101;
  }

  .nav-right-group {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 2rem;
  }

  .main-nav .nav-links {
    display: flex;
    flex-direction: row;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .nav-links a {
    color: #4a5568;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .nav-links a:hover, .nav-links a:focus {
    color: #38A169;
  }

  /* --- Lógica del Dropdown (Desktop) --- */
  .dropdown {
    position: relative;
    padding: 0.5rem 0; /* Área de hover más segura */
  }

  .dropdown-trigger {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    cursor: pointer;
  }

  .arrow {
    font-size: 0.8rem;
    transition: transform 0.3s ease;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    background-color: #ffffff;
    min-width: 280px;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    border-radius: 0.375rem;
    border: 1px solid #e2e8f0;
    list-style: none;
    padding: 0.5rem 0;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.3s ease;
  }

  /* Despliegue en hover solo para dispositivos con puntero (Desktop) */
  @media (hover: hover) and (pointer: fine) {
    .dropdown:hover .dropdown-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    .dropdown:hover .arrow {
      transform: rotate(180deg);
    }
  }

  .dropdown-menu li a {
    display: block;
    padding: 0.75rem 1.5rem;
    font-weight: 500;
    color: #4a5568;
    border-left: 3px solid transparent;
  }

  .dropdown-menu li a:hover {
    background-color: #e6ffed;
    color: #2F855A;
    border-left: 3px solid #38A169;
  }

  .nav-actions {
    display: flex;
    align-items: center;
  }

  .btn-primary {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    background-color: #38A169;
    color: white;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0.375rem;
    white-space: nowrap;
    transition: background-color 0.3s ease;
  }

  .btn-primary:hover {
    background-color: #2F855A;
  }

  /* --- ADAPTACIÓN PARA MÓVILES (Tablets y Teléfonos) --- */
  @media (max-width: 860px) {
    .mobile-toggle {
      display: block; /* Mostrar hamburguesa */
    }

    .nav-right-group {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background-color: #ffffff;
      flex-direction: column;
      align-items: stretch;
      padding: 1.5rem 2rem;
      gap: 1.5rem;
      border-bottom: 1px solid #e2e8f0;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      
      /* Oculto por defecto */
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: all 0.3s ease;
    }

    /* Clase activa que inyectará el JavaScript */
    .nav-right-group.is-active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .main-nav .nav-links {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
      width: 100%;
    }

    /* Adaptación del Dropdown para que fluya hacia abajo en celular */
    .dropdown {
      width: 100%;
    }
    
    .dropdown-menu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: none;
      border-left: 2px solid #48BB78;
      padding: 0.5rem 0 0 0;
      margin-top: 1rem;
      margin-left: 0.5rem;
      border-radius: 0;
      display: none; /* Oculto inicialmente en móvil */
    }

    /* Clase activa para el dropdown en móvil */
    .dropdown.is-open .dropdown-menu {
      display: block;
    }
    .dropdown.is-open .arrow {
      transform: rotate(180deg);
    }

    .nav-actions {
      width: 100%;
      padding-top: 1rem;
      border-top: 1px solid #e2e8f0;
    }

    .btn-primary {
      width: 100%;
      text-align: center;
      padding: 0.75rem;
    }
  }
</style>

<script>
  // Script minimalista para la interactividad táctil
  document.addEventListener('DOMContentLoaded', () => {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const navGroup = document.getElementById('nav-right-group');
    const dropdownTrigger = document.querySelector('.dropdown-trigger');
    const dropdownParent = document.querySelector('.dropdown');

    // Toggle del menú principal
    if (menuBtn && navGroup) {
      menuBtn.addEventListener('click', () => {
        navGroup.classList.toggle('is-active');
      });
    }

    // Toggle del submenú de servicios solo en pantallas pequeñas
    if (dropdownTrigger && dropdownParent) {
      dropdownTrigger.addEventListener('click', (e) => {
        if (window.innerWidth <= 860) {
          e.preventDefault(); // Evita comportamiento por defecto del enlace
          dropdownParent.classList.toggle('is-open');
        }
      });
    }
  });
</script>