---
// src/components/Navbar.astro
// Navegación persistente B2B con soporte móvil e interactividad táctil
---

<header class="navbar-header">
  <div class="navbar-container">
    <a href="/" class="navbar-logo" aria-label="Innova Praxis Inicio">
      <span class="logo-text">Innova<span class="logo-accent">Praxis</span></span>
    </a>

    <button class="mobile-menu-toggle" aria-label="Abrir menú de navegación" aria-expanded="false">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <nav class="navbar-nav" aria-label="Navegación principal">
      <ul class="nav-list">
        <li><a href="/" class="nav-link">Inicio</a></li>
        <li><a href="/#nosotros" class="nav-link">Nosotros</a></li>
        
        <li class="dropdown-item">
          <button class="nav-link dropdown-toggle" aria-expanded="false" aria-haspopup="true">
            Servicios <span class="arrow" aria-hidden="true">▾</span>
          </button>
          <ul class="dropdown-menu" aria-label="Submenú de servicios técnicos">
            <li><a href="/servicios/ingenieria-ambiental">Ingeniería Ambiental y PTAR</a></li>
            <li><a href="/servicios/digitalizacion-ia">Digitalización e IA</a></li>
            <li><a href="/servicios/project-management">Project Management</a></li>
            <li><a href="/servicios/arquitectura-sustentable">Arquitectura Sustentable</a></li>
            <li><a href="/servicios/punto-agil">Punto Ágil (Logística)</a></li>
          </ul>
        </li>

        <li><a href="/#contacto" class="nav-link">Contacto</a></li>
      </ul>
      
      <div class="mobile-only-actions">
        <a href="tel:5584911053" class="btn-nav-phone-mobile">📞 55 8491 1053</a>
      </div>
    </nav>

    <div class="navbar-actions desktop-only">
      <a href="tel:5584911053" class="btn-nav-phone" aria-label="Llamar a línea de enlace directivo">
        <span class="phone-icon" aria-hidden="true">📞</span> 55 8491 1053
      </a>
    </div>
  </div>
</header>

<style>
  /* Variables y Estructura Base */
  .navbar-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 70px;
    background-color: var(--bg-primary, #0B1325);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    z-index: 1000;
  }

  .navbar-container {
    max-width: 1200px;
    margin: 0 auto;
    height: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 2rem;
  }

  /* Logotipo */
  .logo-text {
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 1.5rem;
    color: #FFFFFF;
    text-decoration: none;
  }
  .logo-accent { color: var(--brand-color, #4CE679); }

  /* Menú Escritorio */
  .nav-list {
    display: flex;
    list-style: none;
    gap: 2rem;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .nav-link {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem 0;
    transition: color 0.2s ease;
  }

  .nav-link:hover, .nav-link:focus, .nav-link.active {
    color: var(--brand-color, #4CE679);
  }

  /* Dropdown Escritorio */
  .dropdown-item { position: relative; }
  .dropdown-toggle .arrow {
    font-size: 0.8rem;
    margin-left: 0.2rem;
    transition: transform 0.2s ease;
    display: inline-block;
  }
  
  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    background-color: #111B30;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    list-style: none;
    padding: 0.5rem 0;
    margin: 0;
    width: 260px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  /* Desplegar en Escritorio (Hover) o Móvil (is-active por Script) */
  .dropdown-item:hover .dropdown-menu,
  .dropdown-item.is-active .dropdown-menu {
    opacity: 1;
    visibility: visible;
  }

  /* Rotar flecha si está activo */
  .dropdown-item:hover .arrow,
  .dropdown-item.is-active .arrow {
    transform: rotate(180deg);
  }

  .dropdown-menu a {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .dropdown-menu a:hover {
    background-color: rgba(76, 230, 121, 0.1);
    color: var(--brand-color, #4CE679);
  }

  /* Botones Teléfono */
  .btn-nav-phone, .btn-nav-phone-mobile {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: #FFFFFF;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.5rem 1rem;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.2s ease;
  }
  .btn-nav-phone:hover {
    border-color: var(--brand-color, #4CE679);
    background-color: rgba(76, 230, 121, 0.05);
  }

  .mobile-menu-toggle { display: none; }
  .mobile-only-actions { display: none; }

  /* Responsivo - Móvil */
  @media (max-width: 768px) {
    .desktop-only { display: none; }
    
    .mobile-menu-toggle {
      display: flex;
      flex-direction: column;
      justify-content: space-around;
      width: 30px;
      height: 24px;
      background: transparent;
      border: none;
      cursor: pointer;
      padding: 0;
      z-index: 1001;
    }

    .hamburger-line {
      width: 100%;
      height: 2px;
      background-color: #FFFFFF;
      transition: all 0.3s linear;
      border-radius: 2px;
    }

    /* Transformación de hamburguesa a "X" */
    .mobile-menu-toggle[aria-expanded="true"] .hamburger-line:nth-child(1) {
      transform: translateY(11px) rotate(45deg);
    }
    .mobile-menu-toggle[aria-expanded="true"] .hamburger-line:nth-child(2) {
      opacity: 0;
    }
    .mobile-menu-toggle[aria-expanded="true"] .hamburger-line:nth-child(3) {
      transform: translateY(-11px) rotate(-45deg);
    }

    .navbar-nav {
      position: fixed;
      top: 70px;
      left: -100%;
      width: 100%;
      height: calc(100vh - 70px);
      background-color: #0B1325;
      flex-direction: column;
      padding: 2rem;
      transition: left 0.3s ease;
      overflow-y: auto;
    }

    .navbar-nav.is-open {
      left: 0;
    }

    .nav-list {
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
      gap: 1rem;
    }

    .nav-link {
      font-size: 1.2rem;
      width: 100%;
      text-align: left;
      border-bottom: 1px solid rgba(255,255,255,0.05);
      padding-bottom: 1rem;
    }

    /* Adaptación del Dropdown a Móvil */
    .dropdown-menu {
      position: static;
      transform: none;
      width: 100%;
      box-shadow: none;
      background-color: transparent;
      border: none;
      border-left: 2px solid var(--brand-color, #4CE679);
      margin-top: 0.5rem;
      padding-left: 1rem;
      display: none; 
      opacity: 1;
      visibility: visible;
    }

    /* Script añade la clase .is-active en móvil para mostrar los servicios */
    .dropdown-item.is-active .dropdown-menu {
      display: block;
    }

    .mobile-only-actions {
      display: block;
      margin-top: 2rem;
      width: 100%;
    }
    .btn-nav-phone-mobile {
      width: 100%;
      justify-content: center;
      padding: 1rem;
      background-color: rgba(76, 230, 121, 0.1);
      border-color: var(--brand-color, #4CE679);
      color: var(--brand-color, #4CE679);
    }
  }
</style>

<script>
  // Script minimalista (Vanilla JS) con tipado estricto para TypeScript
  document.addEventListener('DOMContentLoaded', () => {
    const mobileToggle = document.querySelector('.mobile-menu-toggle');
    const navbarNav = document.querySelector('.navbar-nav');
    const dropdownToggle = document.querySelector('.dropdown-toggle');
    const dropdownItem = document.querySelector('.dropdown-item');

    // 1. Abrir/Cerrar el menú hamburguesa
    if (mobileToggle && navbarNav) {
      mobileToggle.addEventListener('click', () => {
        const isExpanded = mobileToggle.getAttribute('aria-expanded') === 'true';
        // Conversión explícita a String para satisfacer a TypeScript
        mobileToggle.setAttribute('aria-expanded', String(!isExpanded));
        navbarNav.classList.toggle('is-open');
      });
    }

    // 2. Soporte táctil para desplegar los Servicios en celular
    if (dropdownToggle && dropdownItem) {
      dropdownToggle.addEventListener('click', (e) => {
        e.preventDefault(); // Previene brincos en la navegación
        dropdownItem.classList.toggle('is-active');
        const isExpanded = dropdownToggle.getAttribute('aria-expanded') === 'true';
        // Conversión explícita a String para satisfacer a TypeScript
        dropdownToggle.setAttribute('aria-expanded', String(!isExpanded));
      });
    }

    // 3. Cerrar el menú móvil automáticamente al hacer clic en un enlace normal
    const normalLinks = document.querySelectorAll('.nav-list > li > a:not(.dropdown-toggle)');
    normalLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (navbarNav?.classList.contains('is-open')) {
          navbarNav.classList.remove('is-open');
          // Aquí siempre fue string ('false'), así que TS no se quejaba
          mobileToggle?.setAttribute('aria-expanded', 'false');
        }
      });
    });
  });
</script>