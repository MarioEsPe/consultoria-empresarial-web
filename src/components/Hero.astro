---
// src/components/Hero.astro
// Componente Hero con tipado estricto B2B
interface Props {
  headline?: string;
  subheadline?: string;
}

const { 
  headline = "Ciencia Aplicada a la Rentabilidad Corporativa.",
  subheadline = "Optimización estratégica de procesos, cumplimiento normativo y transformación digital para el sector inmobiliario e industrial. Convertimos la complejidad técnica en activos operativos."
} = Astro.props;
---

<section class="hero-container" aria-label="Introducción a los servicios de consultoría">
  <div class="hero-grid">
    <div class="hero-content">
      
      <span class="badge">
        Rigor técnico. <strong class="badge-accent">Resultados tangibles.</strong>
      </span>
      
      <h1 class="hero-title">
        Ciencia Aplicada a la <br />
        <span class="highlight">Rentabilidad Corporativa</span>
      </h1>
      
      <p class="hero-description">
        {subheadline}
      </p>

      <blockquote class="hero-quote">
        "La disrupción no busca generar caos, sino encontrar la solución más elegante, eficiente y realista posible."
        <footer>— Dra. Diana Sánchez H.</footer>
      </blockquote>

      <div class="hero-actions">
        <a href="#contacto" class="btn-primary">Agendar Diagnóstico de Viabilidad</a>
        <a href="#servicios" class="btn-secondary">Nuestros Servicios</a>
      </div>
    </div>

    <div class="hero-visual">
      <img 
        src="/optimizacion-procesos-rentabilidad-corporativa-innovapraxis.webp" 
        alt="Consultoría estratégica B2B en InnovaPraxis: Diseño de arquitectura de procesos y reducción de OPEX para la rentabilidad corporativa del sector industrial." 
        title="InnovaPraxis - Metodología de Rentabilidad Corporativa"
        class="hero-image"
        width="800"
        height="600"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  /* --- ESTILOS SCOPED (CSS Puro) --- */
  .hero-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 80vh;
    /* Padding fluido: amplio en desktop (4rem), optimizado en móvil (1rem) */
    padding: clamp(2rem, 5vw, 4rem) clamp(1rem, 4vw, 2rem);
    background-color: #f8fafc; /* Fondo neutro muy claro */
    width: 100%;
  }

  /* Grid Responsivo: 1 columna móvil, 2 columnas desktop */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4rem;
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    width: 100%;
  }

  /* Slogan Oficial */
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 1.25rem;
    border-radius: 9999px;
    background-color: #e6ffed;
    color: #1a202c;
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    margin-bottom: 1.5rem;
    border: 1px solid #48BB78;
  }

  .badge-accent {
    color: #38A169;
    font-weight: 700;
    margin-left: 0.25rem;
  }

  .hero-title {
    /* Límite inferior ajustado a 1.75rem para encajar en pantallas móviles pequeñas */
    font-size: clamp(1.75rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    color: #1a202c;
    margin-bottom: 1.5rem;
    /* Previene que palabras largas rompan el layout en móvil */
    word-wrap: break-word;
    hyphens: auto;
  }

  .highlight {
    color: #38A169;
  }

  .hero-description {
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: #4a5568;
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 540px;
  }

  .hero-quote {
    font-style: italic;
    color: #2F855A;
    border-left: 4px solid #48BB78;
    padding-left: clamp(1rem, 3vw, 1.5rem);
    margin: 0 0 2.5rem 0;
    max-width: 500px;
    font-size: clamp(0.95rem, 2.5vw, 1.05rem);
    line-height: 1.5;
  }

  .hero-quote footer {
    display: block;
    font-style: normal;
    font-weight: 600;
    font-size: 0.85rem;
    margin-top: 0.75rem;
    color: #4a5568;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    width: 100%;
    /* Comportamiento móvil por defecto: botones apilados al 100% del ancho */
    flex-direction: column;
    align-items: stretch;
  }

  .btn-primary, .btn-secondary {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0.375rem;
    transition: all 0.3s ease;
    text-align: center;
  }

  .btn-primary {
    background-color: #38A169;
    color: white;
    border: 2px solid #38A169;
  }

  .btn-primary:hover {
    background-color: #2F855A;
    border-color: #2F855A;
  }

  .btn-secondary {
    background-color: transparent;
    color: #38A169;
    border: 2px solid #38A169;
  }

  .btn-secondary:hover {
    background-color: #e6ffed;
    color: #2F855A;
    border-color: #2F855A;
  }

  /* Breakpoint para pantallas medianas/grandes (Tablets y Desktop) */
  @media (min-width: 640px) {
    .hero-actions {
      flex-direction: row;
      align-items: center;
      width: auto;
    }
    
    .btn-primary, .btn-secondary {
      width: auto;
    }
  }

  /* --- Estilos del Contenedor Visual --- */
  .hero-visual {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-image {
  width: 100%;
  height: auto;
  /* Cambiamos 'cover' por 'contain' para garantizar que no se corte ningún borde */
  object-fit: contain; 
  border-radius: 0.5rem;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }
</style>
