---
// src/components/Hero.astro
// Componente Hero con tipado estricto (si requieres pasar props en el futuro)
interface Props {
  title?: string;
}

const { title = "Innova Praxis" } = Astro.props;
---

<section class="hero-container">
  <div class="hero-content">
    <span class="badge">Ciencia Aplicada a Negocios</span>
    <h1 class="hero-title">
      Transformación Digital y <br />
      <span class="highlight">Liderazgo Sustentable</span>
    </h1>
    
    <p class="hero-description">
      Impulsamos la optimización de procesos para garantizar la rentabilidad empresarial a través de la innovación tecnológica y las finanzas corporativas.
    </p>

    <blockquote class="hero-quote">
      "La disrupción no busca generar caos, sino encontrar la solución más elegante, eficiente y realista posible."
      <footer>— Dra. Diana Sánchez H.</footer>
    </blockquote>

    <div class="hero-actions">
      <a href="#contacto" class="btn-primary">Agenda un Diagnóstico Organizacional</a>
      <a href="#servicios" class="btn-secondary">Nuestros Servicios</a>
    </div>
  </div>
</section>

<style>
  /* --- ESTILOS SCOPED (CSS Puro) --- */
  .hero-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 80vh;
    padding: 2rem;
    background-color: #f8fafc; /* Fondo neutro muy claro para resaltar los verdes */
    text-align: center;
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .badge {
    display: inline-block;
    padding: 0.25rem 1rem;
    border-radius: 9999px;
    background-color: #e6ffed;
    color: #2F855A;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    color: #1a202c;
    margin-bottom: 1.5rem;
  }

  .highlight {
    color: #38A169;
  }

  .hero-description {
    font-size: clamp(1.125rem, 2vw, 1.25rem);
    color: #4a5568;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .hero-quote {
    font-style: italic;
    color: #2F855A;
    border-left: 4px solid #48BB78;
    padding-left: 1.5rem;
    margin: 0 auto 2.5rem auto;
    max-width: 600px;
    font-size: 1.1rem;
    text-align: left;
  }

  .hero-quote footer {
    font-style: normal;
    font-weight: 600;
    font-size: 0.9rem;
    margin-top: 0.5rem;
    color: #4a5568;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background-color: #38A169;
    color: white;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0.375rem;
    transition: background-color 0.3s ease;
  }

  .btn-primary:hover {
    background-color: #2F855A;
  }

  .btn-secondary {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background-color: transparent;
    color: #38A169;
    font-weight: 600;
    text-decoration: none;
    border: 2px solid #38A169;
    border-radius: 0.375rem;
    transition: all 0.3s ease;
  }

  .btn-secondary:hover {
    background-color: #e6ffed;
  }
</style>